---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { sitePath } from "../lib/site";

const posts = await getPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="home-intro">
    <PageHeading text="hello" />
    <p class="intro-copy">
      A place for notes, thoughts, and whatever else is worth sharing.
    </p>
  </section>

  <section class="content-section" aria-labelledby="recent-heading">
    <div class="section-heading">
      <h2 id="recent-heading">Recent posts</h2>
      <a class="text-link" href={sitePath("posts/")}>View archive <span aria-hidden="true">→</span></a>
    </div>
    <PostList posts={recentPosts} />
  </section>
</BaseLayout>
