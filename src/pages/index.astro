---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import { sitePath } from "../lib/site";

const posts = await getPosts();
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <section class="home-intro">
    <p class="eyebrow"><span aria-hidden="true">~/</span> hello</p>
    <h1>A little corner of the internet.</h1>
    <p class="intro-copy">
      Hi, I’m Henry. This is a place for notes, thoughts, and whatever else
      catches my attention.
    </p>
  </section>

  <section class="content-section" aria-labelledby="recent-heading">
    <div class="section-heading">
      <h2 id="recent-heading">Recent posts</h2>
      <a class="text-link" href={sitePath("posts/")}>View archive <span aria-hidden="true">→</span></a>
    </div>
    <PostList posts={recentPosts} />
  </section>
</BaseLayout>
