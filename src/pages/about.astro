---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
---

<BaseLayout
  title="About"
  description="About the stdout blog."
>
  <article class="prose">
    <PageHeading text="about" />
    <p>
      This is a corner of the internet for notes, thoughts, and whatever catches
      my attention. The topics may change; that’s part of the point.
    </p>
    <p>
      I write here at my own pace. You can follow new posts through the <a href="/stdout/rss.xml">RSS feed</a>.
    </p>
  </article>
</BaseLayout>
