---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import { sitePath } from "../lib/site";
---

<BaseLayout
  title="About"
  description="About the stdout blog."
  indexable
>
  <PageHeading text="about" />

  <article class="prose">
    <p>
      This is a corner of the internet for notes, thoughts, and whatever catches
      my attention. The topics may change; that’s part of the point.
    </p>
    <p>
      I write here at my own pace. You can follow new posts through the{" "}
      <a href={sitePath("rss.xml")}>RSS feed</a>.
    </p>
  </article>
</BaseLayout>
