---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/PageHeading.astro";
import TagList from "../../components/TagList.astro";
import { getPosts, readingTime, type Post } from "../../lib/posts";
import {
  SITE,
  absoluteUrl,
  formatDate,
  postPath,
  sitePath,
} from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const timeToRead = readingTime(post.body ?? "");
const siteUrl = Astro.site ?? new URL(import.meta.env.SITE);
const articleUrl = absoluteUrl(postPath(post.id), siteUrl);

const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate
    ? { dateModified: post.data.updatedDate.toISOString() }
    : {}),
  author: {
    "@type": "Person",
    name: SITE.author,
  },
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  inLanguage: SITE.language,
  keywords: post.data.tags.join(", "),
  isPartOf: {
    "@type": "WebSite",
    name: SITE.title,
    url: absoluteUrl(sitePath(""), siteUrl),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  indexable
  ogType="article"
  publishedTime={post.data.pubDate}
  updatedTime={post.data.updatedDate}
  tags={post.data.tags}
  structuredData={postJsonLd}
>
  <article class="article">
    <header class="article-header">
      <PageHeading text="writing" as="p" />
      <h1 data-pagefind-meta="title" data-pagefind-ignore>{post.data.title}</h1>
      <div class="article-meta" data-pagefind-ignore>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {formatDate(post.data.updatedDate)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{timeToRead}</span>
        {
          import.meta.env.DEV && post.data.draft && (
            <>
              <span aria-hidden="true">·</span>
              <span class="draft-label">draft preview</span>
            </>
          )
        }
      </div>
      <TagList
        tags={post.data.tags}
        class="article-tags"
        pagefindIgnore
      />
    </header>

    <div class="prose article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
