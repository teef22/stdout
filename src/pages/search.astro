---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/PageHeading.astro";
import { sitePath } from "../lib/site";
---

<BaseLayout
  title="Search"
  description="Search posts and pages on stdout."
  searchAssets={true}
>
  <section class="content-section">
    <PageHeading text="search" />

    <pagefind-config
      bundle-path="/stdout/pagefind/"
      base-url="/stdout/"
    ></pagefind-config>
    <div class="search-interface">
      <div class="search-terminal">
        <pagefind-input placeholder="Search the site…"></pagefind-input>
      </div>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
    <noscript>
      <p class="empty-state">Search needs JavaScript. You can browse <a href={sitePath("")}>all posts</a> instead.</p>
    </noscript>
  </section>
</BaseLayout>
