---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeading from "../../components/PageHeading.astro";
import { getPosts, getTagGroups } from "../../lib/posts";
import { tagPath } from "../../lib/site";

const posts = await getPosts();
const tags = getTagGroups(posts);
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <section class="content-section">
    <PageHeading text="tags" />
    {
      tags.length > 0 ? (
        <ul class="tag-directory">
          {tags.map((tag) => (
            <li>
              <a
                href={tagPath(tag.name)}
                aria-label={`${tag.name}, ${tag.count} ${
                  tag.count === 1 ? "post" : "posts"
                }`}
              >
                <span>{tag.name}</span>
                <span class="tag-count" aria-hidden="true">
                  {tag.count}
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Tags will appear here when posts are published.</p>
      )
    }
  </section>
</BaseLayout>
