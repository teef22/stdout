---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";
import { tagPath, tagSlug } from "../../lib/site";

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))]
  .sort((a, b) => a.localeCompare(b))
  .map((name) => ({
    name,
    slug: tagSlug(name),
    count: posts.filter((post) => post.data.tags.includes(name)).length,
  }));
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <section class="content-section">
    <p class="eyebrow"><span aria-hidden="true">~/</span> index</p>
    <h1 class="page-title">Tags</h1>
    <p class="page-description">Browse posts by topic.</p>
    {
      tags.length > 0 ? (
        <ul class="tag-directory">
          {tags.map((tag) => (
            <li>
              <a href={tagPath(tag.name)}>
                <span>{tag.name}</span>
                <span class="tag-count">{tag.count}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Tags will appear here when posts are published.</p>
      )
    }
  </section>
</BaseLayout>
